rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Administrator access is granted by the account email alone; no email
    // verification step is required.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'zacheussimbaya@gmail.com';
    }

    // All new site uploads use Cloudinary. These rules only preserve retrieval
    // and administrator cleanup for portfolio files created before migration.
    match /portfolio/{ownerId}/{fileName} {
      allow get: if true;
      allow list: if false;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // Legacy Firebase CVs remain private and administrator-deletable. New CVs
    // are authenticated Cloudinary assets and never upload to this path.
    match /applications/{fileName} {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
