# ---- Seedwel Investment Limited / Seedwel Workplace -------------------------
# Copy to .env and adjust. Never commit real secrets.

# Public base URL used for canonical URLs, sitemap, Open Graph and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign session cookies and invitation tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-me-with-a-long-random-string

# Where the SQLite database file lives (relative to project root if not absolute).
DATABASE_PATH=./data/seedwel.db

# Directory for private, access-controlled uploads (CVs, contracts, staff docs).
PRIVATE_UPLOAD_DIR=./data/uploads

# Email delivery. "outbox" (default) stores messages in the database so they can be
# read in Admin -> Settings -> Email outbox; set "console" to log them instead.
MAIL_DRIVER=outbox
MAIL_FROM_NAME=Seedwel Investment Limited
MAIL_FROM_EMAIL=no-reply@seedwel.example

# Bootstrap administrator created the first time the database is seeded.
ADMIN_EMAIL=admin@seedwel.example
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_FIRST_NAME=Seedwell
ADMIN_LAST_NAME=Masuku
